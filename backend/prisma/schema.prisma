generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Edificio {
  id        String        @id
  nombre    String
  ubicacion String?
  activo    Boolean       @default(true)

  laboratorios Laboratorio[]

  @@map("edificios")
}

model Rol {
  id           String    @id
  nombre       String    @unique
  descripcion  String?
  nivelAcceso  Int       @map("nivel_acceso")
  usuarios     Usuario[]

  @@map("roles")
}

model CategoriaInventario {
  id          String         @id
  nombre      String         @unique
  stockMinimo Int            @default(0) @map("stock_minimo")
  activo      Boolean        @default(true)
  inventario  InventarioItem[]

  @@map("categorias_inventario")
}

model TipoMantenimiento {
  id           String         @id
  nombre       String         @unique
  mantenimientos Mantenimiento[]

  @@map("tipo_mantenimiento")
}

model EstadoMantenimiento {
  id           String         @id
  nombre       String         @unique
  mantenimientos Mantenimiento[]

  @@map("estado_mantenimiento")
}

model EstadoEquipo {
  id      String  @id
  nombre  String  @unique
  equipos Equipo[]

  @@map("estado_equipo")
}

model EstadoIncidencia {
  id          String       @id
  nombre      String       @unique
  incidencias Incidencia[]

  @@map("estado_incidencia")
}

model Persona {
  id              String      @id
  nombres         String
  paterno         String
  materno         String?
  ci              String?     @unique
  registroUniversitario String? @unique @map("registro_universitario")
  email           String?     @unique
  celular         String?
  fotoUrl         String?     @map("foto_url")
  activo          Boolean     @default(true)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  usuario             Usuario?
  laboratorios        Laboratorio[]    @relation("EncargadoLaboratorio")
  gruposDocente       Grupo[]          @relation("DocenteGrupo")
  inscripciones       Inscripcion[]
  incidencias         Incidencia[]
  usosLaboratorio     UsoLaboratorio[]

  @@map("personas")
}

model Usuario {
  id           String    @id
  personaId    String    @unique @map("persona_id")
  roleId       String    @map("role_id")
  passwordHash String    @map("password_hash")
  ultimoAcceso DateTime? @map("ultimo_acceso")
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  persona           Persona            @relation(fields: [personaId], references: [id], onDelete: Cascade)
  rol               Rol                @relation(fields: [roleId], references: [id])
  mantenimientos    Mantenimiento[]
  incidencias       Incidencia[]
  asignaciones      Asignacion[]
  reportesPasante   ReportePasante[]
  reportesAtendidos ReportePasante[]   @relation("AtendidoPor")
  logs              Log[]

  @@map("usuarios")
}

model Laboratorio {
  id               String       @id
  nombre           String
  edificioId       String       @map("edificio_id")
  piso             Int
  capacidadEquipos Int          @map("capacidad_equipos")
  capacidadPersonas Int         @map("capacidad_personas")
  encargadoId      String?      @map("encargado_id")
  activo           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  edificio         Edificio     @relation(fields: [edificioId], references: [id])
  encargado        Persona?     @relation("EncargadoLaboratorio", fields: [encargadoId], references: [id])
  equipos          Equipo[]
  perifericos      Periferico[]
  inventario       InventarioItem[]
  incidencias      Incidencia[]
  mantenimientos   Mantenimiento[]
  horarios         Horario[]
  usosLaboratorio  UsoLaboratorio[]

  @@map("laboratorios")
}

model Equipo {
  codigo           String       @id
  nombre           String
  laboratorioId    String       @map("laboratorio_id")
  fila             String?
  puesto           String?
  sistemaOperativo String?      @map("sistema_operativo")
  marca            String?
  modelo           String?
  numeroSerie      String?      @unique @map("numero_serie")
  estadoId         String       @map("estado_id")
  fechaCompra      DateTime?    @map("fecha_compra")
  activo           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  laboratorio      Laboratorio  @relation(fields: [laboratorioId], references: [id])
  estado           EstadoEquipo @relation(fields: [estadoId], references: [id])
  mantenimientos   Mantenimiento[]
  incidencias      Incidencia[]
  asignaciones     Asignacion[]
  perifericos      Periferico[]
  inventarioItems  InventarioItem[]

  @@unique([laboratorioId, fila, puesto])
  @@map("equipos")
}

model Periferico {
  id             String      @id
  tipo           String
  marca          String?
  modelo         String?
  numeroSerie    String?     @map("numero_serie")
  laboratorioId  String?     @map("laboratorio_id")
  equipoCodigo   String?     @map("equipo_codigo")
  estado         String      @default("Funcionando")
  activo         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")

  laboratorio    Laboratorio? @relation(fields: [laboratorioId], references: [id])
  equipo         Equipo?      @relation(fields: [equipoCodigo], references: [codigo])

  @@map("perifericos")
}

model InventarioItem {
  id               String               @id
  categoriaId      String               @map("categoria_id")
  codigoItic       String               @unique @map("codigo_itic")
  codigoFacultativo String?              @map("codigo_facultativo")
  codigoUmsa       String?              @map("codigo_umsa")
  numeroSerie      String?              @map("numero_serie")
  marca            String?
  modelo           String?
  estado           String               @default("En almacén")
  fechaIngreso     DateTime             @map("fecha_ingreso")
  fechaAsignacion  DateTime?            @map("fecha_asignacion")
  laboratorioId    String?              @map("laboratorio_id")
  equipoCodigo     String?              @map("equipo_codigo")
  observaciones    String?
  activo           Boolean              @default(true)
  createdAt        DateTime             @default(now()) @map("created_at")

  categoria        CategoriaInventario  @relation(fields: [categoriaId], references: [id])
  laboratorio      Laboratorio?         @relation(fields: [laboratorioId], references: [id])
  equipo           Equipo?              @relation(fields: [equipoCodigo], references: [codigo])

  @@map("inventario")
}

model Insumo {
  nombre       String        @id
  unidadMedida String        @map("unidad_medida")
  stock        Int           @default(0)
  stockMinimo  Int           @default(0) @map("stock_minimo")
  activo       Boolean       @default(true)
  updatedAt    DateTime      @updatedAt @map("updated_at")

  insumosUsados InsumoUsado[]

  @@map("insumos")
}

model Mantenimiento {
  id            String                @id
  tipoId        String                @map("tipo_id")
  equipoCodigo  String                @map("equipo_codigo")
  tecnicoId     String                @map("tecnico_id")
  laboratorioId String?               @map("laboratorio_id")
  fecha         DateTime
  horaInicio    DateTime?             @map("hora_inicio")
  horaFin       DateTime?             @map("hora_fin")
  estadoId      String                @map("estado_id")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  tipo          TipoMantenimiento     @relation(fields: [tipoId], references: [id])
  equipo        Equipo                @relation(fields: [equipoCodigo], references: [codigo])
  tecnico       Usuario               @relation(fields: [tecnicoId], references: [id])
  laboratorio   Laboratorio?          @relation(fields: [laboratorioId], references: [id])
  estado        EstadoMantenimiento   @relation(fields: [estadoId], references: [id])
  detalle       MantenimientoDetalle?

  @@map("mantenimientos")
}

model MantenimientoDetalle {
  id              String        @id
  mantenimientoId String        @unique @map("mantenimiento_id")
  descripcion     String?
  diagnostico     String?
  accionRealizada String?       @map("accion_realizada")
  resolucion      String?
  tipoIncidencia  String?       @map("tipo_incidencia")
  estadoFinal     String?       @map("estado_final")
  observaciones   String?
  recomendaciones String?

  mantenimiento Mantenimiento  @relation(fields: [mantenimientoId], references: [id], onDelete: Cascade)
  checklists     Checklist[]
  insumosUsados  InsumoUsado[]

  @@map("mantenimientos_detalle")
}

model Checklist {
  id          String             @id
  detalleId   String             @map("detalle_id")
  categoria   String
  item        String
  estado      String
  observacion String?

  detalle MantenimientoDetalle  @relation(fields: [detalleId], references: [id], onDelete: Cascade)

  @@map("checklists")
}

model InsumoUsado {
  id           String             @id
  detalleId    String             @map("detalle_id")
  insumoNombre String             @map("insumo_nombre")
  cantidad     String
  createdAt    DateTime           @default(now()) @map("created_at")

  detalle      MantenimientoDetalle @relation(fields: [detalleId], references: [id], onDelete: Cascade)
  insumo       Insumo               @relation(fields: [insumoNombre], references: [nombre])

  @@map("insumos_usados")
}

model Incidencia {
  id                   String            @id
  equipoCodigo         String?           @map("equipo_codigo")
  laboratorioId        String?           @map("laboratorio_id")
  usuarioId            String?           @map("usuario_id")
  personaId            String?           @map("persona_id")
  problema             String
  requiereSeguimiento  Boolean           @default(false) @map("requiere_seguimiento")
  estadoId             String            @map("estado_id")
  fecha                DateTime          @default(now())
  resueltaEn           DateTime?         @map("resuelta_en")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  equipo               Equipo?           @relation(fields: [equipoCodigo], references: [codigo])
  laboratorio          Laboratorio?      @relation(fields: [laboratorioId], references: [id])
  usuario              Usuario?          @relation(fields: [usuarioId], references: [id])
  persona              Persona?          @relation(fields: [personaId], references: [id])
  estado               EstadoIncidencia  @relation(fields: [estadoId], references: [id])

  @@map("incidencias")
}

model Asignacion {
  id            String    @id
  equipoCodigo  String    @map("equipo_codigo")
  laboratorioId String?   @map("laboratorio_id")
  tecnicoId     String    @map("tecnico_id")
  problema      String
  prioridad     String    @default("Media")
  fecha         DateTime
  estado        String    @default("Pendiente")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  equipo        Equipo    @relation(fields: [equipoCodigo], references: [codigo])
  tecnico       Usuario   @relation(fields: [tecnicoId], references: [id])

  @@map("asignaciones")
}

model ReportePasante {
  id                String    @id
  pasanteId         String    @map("pasante_id")
  titulo            String
  descripcion       String
  laboratorioId     String?   @map("laboratorio_id")
  ubicacion         String?
  categoria         String?
  prioridad         String    @default("Media")
  fecha             DateTime  @default(now())
  estado            String    @default("Nuevo")
  resolucionDetalle String?   @map("resolucion_detalle")
  atendidoPor       String?   @map("atendido_por")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  pasante           Usuario   @relation(fields: [pasanteId], references: [id])
  atendidoPorUser   Usuario?  @relation("AtendidoPor", fields: [atendidoPor], references: [id])

  @@map("reportes_pasante")
}

model Log {
  id          String   @id
  timestamp   DateTime @default(now())
  usuarioId   String?  @map("usuario_id")
  accion      String
  detalle     String?
  modulo      String?
  entidad     String?
  equipoCodigo String? @map("equipo_codigo")
  tipoAccion  String?  @map("tipo_accion")
  estado      String   @default("Éxito")
  ipOrigen    String?  @map("ip_origen")

  usuario     Usuario? @relation(fields: [usuarioId], references: [id])

  @@map("logs")
}

model Materia {
  codigo       String   @id
  nombre       String
  sigla        String   @unique
  nivel        Int
  horasTeoricas Int     @map("horas_teoricas")
  horasPracticas Int    @map("horas_practicas")
  activo       Boolean  @default(true)

  grupos       Grupo[]

  @@map("materias")
}

model Grupo {
  id            String    @id
  materiaCodigo String    @map("materia_codigo")
  numeroGrupo   String    @map("numero_grupo")
  gestion       Int
  periodo       String
  docenteId     String?   @map("docente_id")
  cupoMaximo    Int       @map("cupo_maximo")
  activo        Boolean   @default(true)

  materia       Materia   @relation(fields: [materiaCodigo], references: [codigo])
  docente       Persona?  @relation("DocenteGrupo", fields: [docenteId], references: [id])
  horarios      Horario[]
  inscripciones Inscripcion[]
  usosLaboratorio UsoLaboratorio[]

  @@unique([materiaCodigo, numeroGrupo, gestion, periodo])
  @@map("grupos")
}

model Horario {
  id            String     @id
  grupoId       String     @map("grupo_id")
  laboratorioId String     @map("laboratorio_id")
  diaSemana     Int        @map("dia_semana")
  horaInicio    DateTime   @map("hora_inicio")
  horaFin       DateTime   @map("hora_fin")
  tipoClase     String     @default("Práctica") @map("tipo_clase")

  grupo         Grupo      @relation(fields: [grupoId], references: [id])
  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id])

  @@unique([laboratorioId, diaSemana, horaInicio])
  @@map("horarios")
}

model Inscripcion {
  id               String   @id
  personaId        String   @map("persona_id")
  grupoId          String   @map("grupo_id")
  fechaInscripcion DateTime @map("fecha_inscripcion")
  activo           Boolean  @default(true)

  persona          Persona  @relation(fields: [personaId], references: [id])
  grupo            Grupo    @relation(fields: [grupoId], references: [id])

  @@unique([personaId, grupoId])
  @@map("inscripciones")
}

model UsoLaboratorio {
  id            String     @id
  laboratorioId String     @map("laboratorio_id")
  grupoId       String?    @map("grupo_id")
  personaId     String?    @map("persona_id")
  fecha         DateTime
  horaIngreso   DateTime   @map("hora_ingreso")
  horaSalida    DateTime?  @map("hora_salida")
  motivo        String?
  createdAt     DateTime   @default(now()) @map("created_at")

  laboratorio   Laboratorio @relation(fields: [laboratorioId], references: [id])
  grupo         Grupo?      @relation(fields: [grupoId], references: [id])
  persona       Persona?    @relation(fields: [personaId], references: [id])

  @@map("uso_laboratorio")
}
